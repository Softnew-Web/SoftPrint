<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>softprint</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SoftPrint.Domain\SoftPrint.Domain.csproj" />
    <ProjectReference Include="..\SoftPrint.Application\SoftPrint.Application.csproj" />
    <ProjectReference Include="..\SoftPrint.Infrastructure.Core\SoftPrint.Infrastructure.Core.csproj" />
    <ProjectReference Include="..\SoftPrint.Api\SoftPrint.Api.csproj" />
    <ProjectReference Include="..\SoftPrint.Printing.Linux\SoftPrint.Printing.Linux.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\SoftPrint.Host.Windows\.env.example" Link=".env.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\SoftPrint.Host.Windows\wwwroot\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\SoftPrint.Host.Windows\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>

# AutoPrint — edite e reinicie o aplicativo para aplicar.
# Copie este arquivo para .env se ainda não existir.

URLS=http://127.0.0.1:5178
HEADLESS=false
SIMULATION=true
PRINTER_NAME=
POLL_INTERVAL_MS=500
START_WITH_WINDOWS=false
RETENTION_DAYS=30
BACKUP_INTERVAL_MINUTES=60
SOUND_ENABLED=true
DARK_THEME=false
LOG_TO_FILE=true
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_RETRY_SECONDS=15
WEBHOOK_MAX_RETRIES=8
EVENT_LOG_FOLDER=logs
EVENT_LOG_RETENTION_DAYS=30
# Opcional: valor inicial. Prefira escolher a pasta no painel (aba Conectar).
INBOX_FOLDER=
INBOX_ENABLED=false
DELETE_INBOX_AFTER_PRINT=false
NETWORK_SCAN_TIMEOUT_MS=400
PRINTER_ROUTES=
TEMPLATES=recibo=RECIBO {reference}\n{text}\n{now}||etiqueta=*{type}*\n{text}
STATUS_PENDING_WIRE=pending
STATUS_PENDING_LABEL=Na fila
STATUS_PROCESSING_WIRE=processing
STATUS_PROCESSING_LABEL=Enviando
STATUS_SIMULATED_WIRE=simulated
STATUS_SIMULATED_LABEL=Simulado
STATUS_SENT_WIRE=sent
STATUS_SENT_LABEL=Enviado ao Windows
STATUS_UNCERTAIN_WIRE=uncertain
STATUS_UNCERTAIN_LABEL=Conferir envio

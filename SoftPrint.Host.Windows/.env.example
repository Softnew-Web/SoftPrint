# SoftPrint — override administrativo opcional.
# O executável funciona sem este arquivo. Copie para .env somente se precisar
# forçar valores acima das configurações salvas no perfil do usuário.

URLS=http://127.0.0.1:5178
HEADLESS=false
START_IN_TRAY=false
SIMULATION=true
PRINTER_NAME=
POLL_INTERVAL_MS=100
START_WITH_WINDOWS=false
RETENTION_DAYS=30
BACKUP_INTERVAL_MINUTES=60
SOUND_ENABLED=true
DARK_THEME=false
LOG_TO_FILE=true
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_RETRY_SECONDS=15
WEBHOOK_MAX_RETRIES=8
EVENT_LOG_FOLDER=logs
EVENT_LOG_RETENTION_DAYS=30
FILE_LOG_RETENTION_DAYS=30
# Opcional: valor inicial. Prefira escolher a pasta no painel (aba Conectar).
INBOX_FOLDER=
INBOX_ENABLED=false
DELETE_INBOX_AFTER_PRINT=false
NETWORK_SCAN_TIMEOUT_MS=400
PRINTER_ROUTES=
TEMPLATES=recibo=RECIBO {reference}\n{text}\n{now}||etiqueta=*{type}*\n{text}
# Atualizações via GitHub Releases (https://github.com/Softnew-Web/SoftPrint/releases)
UPDATE_CHECK_ENABLED=true
UPDATE_GITHUB_OWNER=Softnew-Web
UPDATE_GITHUB_REPO=SoftPrint
# Releases públicos não precisam de token. NÃO embutimos PAT no instalador.
# Em repo privado, defina localmente (nunca no zip de update):
# UPDATE_GITHUB_TOKEN=
UPDATE_CACHE_MINUTES=360
UPDATE_ASSET_NAME=SoftPrint-Setup.exe
UPDATE_ALWAYS_MANDATORY=false
# Só baixa/reinicia sozinho se a versão for obrigatória. Aviso de versão nova no splash continua ativo.
AUTO_UPDATE_ON_STARTUP=false
# true = recusa update se SoftPrint.exe não tiver Authenticode (use com CODE_SIGNING no CI)
REQUIRE_SIGNED_UPDATES=false
PRINT_JOB_TIMEOUT_SECONDS=180
ALLOW_NON_LOOPBACK_BINDING=false
QUEUE_STALL_ALERT_MINUTES=5
# Telemetria opt-in (falhas + heartbeat de frota — sem texto/caminhos/chaves):
TELEMETRY_ENABLED=false
TELEMETRY_URL=
TELEMETRY_HEARTBEAT_HOURS=6

STATUS_PENDING_WIRE=pending
STATUS_PENDING_LABEL=Na fila
STATUS_PROCESSING_WIRE=processing
STATUS_PROCESSING_LABEL=Enviando
STATUS_SIMULATED_WIRE=simulated
STATUS_SIMULATED_LABEL=Simulado
STATUS_SENT_WIRE=sent
STATUS_SENT_LABEL=Enviado ao Windows
STATUS_UNCERTAIN_WIRE=uncertain
STATUS_UNCERTAIN_LABEL=Conferir envio
